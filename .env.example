# Desktop analytics is opt-in at build time and is read only by `build:release`.
# Copy these values to `.env.desktop-release.local`; never commit that local file.
# Export the same values into the packaging shell or CI environment before running dist:win.
ROUTEMARKET_WORK_UMAMI_HOST=https://analytics.example.com
ROUTEMARKET_WORK_UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000000

# Use a durable Core/CDN logical feed URL here, not a version-specific R2 object URL.
# electron-updater requests latest.yml or beta.yml and the referenced artifacts below this path.
ROUTEMARKET_WORK_UPDATE_URL=https://downloads.example.com/desktop-updates/v1/windows/x64
ROUTEMARKET_WORK_UPDATE_CHANNEL=stable
ROUTEMARKET_WORK_ROLLOUT_PERCENT=100

# Windows signing values are required by dist:win. Keep the real values in local or CI secrets.
# CSC_LINK=<certificate path or encoded certificate>
# CSC_KEY_PASSWORD=<certificate password>
