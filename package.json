{
  "name": "routemarket-work",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "marketplace:sign-plugin": "node scripts/sign-marketplace-plugin.mjs",
    "build": "corepack pnpm -r run build",
    "dev": "corepack pnpm --filter @routemarket/work-desktop dev",
    "dev:web": "corepack pnpm --filter @routemarket/work-desktop dev:web",
    "dist:win": "corepack pnpm --filter @routemarket/work-desktop run dist:win",
    "dist:win:dir": "corepack pnpm --filter @routemarket/work-desktop run dist:win:dir",
    "dist:mac": "corepack pnpm --filter @routemarket/work-desktop run dist:mac",
    "lint": "corepack pnpm -r run lint",
    "test": "corepack pnpm -r run test",
    "test:chat-smoke": "corepack pnpm --filter @routemarket/work-desktop run test:chat-smoke",
    "test:core-e2e": "node scripts/run-core-work-e2e.mjs",
    "test:release-manifest": "node --test scripts/write-release-manifest.test.mjs",
    "test:release": "node --test scripts/write-release-manifest.test.mjs scripts/check-release-environment.test.mjs scripts/prepare-update-metadata.test.mjs scripts/verify-production-bundle.test.mjs scripts/desktop-release-config.test.mjs",
    "typecheck": "corepack pnpm -r run typecheck"
  }
}
