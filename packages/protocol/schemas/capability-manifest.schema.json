{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.routemarket.ai/work/v1/capability-manifest.schema.json",
  "title": "RouteMarket Work Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "generatedAt", "runtime", "limits", "capabilities", "projects", "mcpServers", "signingKeys", "localSkills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "appVersion", "workerVersion"],
      "properties": {
        "platform": { "enum": ["windows", "macos"] },
        "arch": { "enum": ["x64", "arm64"] },
        "appVersion": { "type": "string", "minLength": 1 },
        "workerVersion": { "type": "string", "minLength": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentJobs", "maxInlineResultBytes"],
      "properties": {
        "maxConcurrentJobs": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxInlineResultBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "version", "risk", "operations"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
          "version": { "type": "integer", "minimum": 1 },
          "risk": { "enum": ["R0", "R1", "R2", "R3"] },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectBindingId", "localProjectId", "access", "rootFingerprint"],
        "properties": {
          "projectBindingId": { "type": "string", "minLength": 8 },
          "localProjectId": { "type": "string", "minLength": 8 },
          "access": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["read", "write"] }
          },
          "rootFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "signingKeys": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKey", "trust"],
        "properties": {
          "keyId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,256}$" },
          "algorithm": { "const": "ed25519" },
          "publicKey": { "type": "string", "minLength": 43, "maxLength": 128 },
          "trust": { "enum": ["device", "publisher"] }
        }
      }
    },
    "localSkills": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skillId",
          "version",
          "packageDigest",
          "signingKeyId",
          "signature",
          "projectBindingId",
          "permissions",
          "operations"
        ],
        "properties": {
          "skillId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,99}$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"
          },
          "packageDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signingKeyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{3,256}$"
          },
          "signature": { "type": "string", "minLength": 80, "maxLength": 128 },
          "projectBindingId": {
            "type": ["string", "null"],
            "minLength": 8,
            "maxLength": 256
          },
          "permissions": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": ["project.read", "project.write", "network", "process", "external_apps"]
            }
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      }
    }
  }
}
