{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.routemarket.ai/work/v1/plugin-manifest.schema.json",
  "title": "RouteMarket Work Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "name", "description", "version", "publisher",
    "kind", "status", "distribution", "engines", "permissions", "activationEvents", "contributes"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "maxLength": 2048 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"
    },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["host_runtime", "declarative_plugin", "desktop_extension"] },
    "status": { "enum": ["available", "planned", "disabled"] },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "packageFormat"],
      "properties": {
        "source": { "enum": ["bundled", "marketplace", "local"] },
        "packageFormat": { "enum": ["declarative", "desktop-extension"] },
        "integrity": false,
        "signature": false
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routemarketWork"],
      "properties": {
        "routemarketWork": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "project.read", "project.write", "network", "process", "external_apps",
          "browser.read", "browser.interact", "artifact.read", "artifact.write",
          "device.gpu", "data.read", "media.read", "media.write", "media.upload.cloud",
          "models.manage", "models.invoke.local", "models.invoke.cloud",
          "biometric.face", "biometric.voice"
        ]
      }
    },
    "activationEvents": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 256 }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "requiresCapabilities": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/capabilityRequirement" }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models"],
      "properties": {
        "models": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/modelResource" }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewers", "tools", "workflowNodes", "connectors"],
      "properties": {
        "viewers": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/viewer" }
        },
        "tools": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/tool" }
        },
        "workflowNodes": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/workflowNode" }
        },
        "connectors": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/connector" }
        },
        "navigation": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/navigation" }
        },
        "pages": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/page" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "desktop_extension" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["runtime"],
        "properties": {
          "runtime": {},
          "schemaVersion": { "const": 2 },
          "distribution": {
            "type": "object",
            "properties": { "packageFormat": { "const": "desktop-extension" } }
          },
          "permissions": { "type": "array", "contains": { "const": "process" } },
          "contributes": {
            "type": "object",
            "required": ["navigation", "pages"],
            "properties": {
              "navigation": { "type": "array", "minItems": 1 },
              "pages": { "type": "array", "minItems": 1 }
            }
          }
        }
      },
      "else": {
        "not": {
          "properties": { "runtime": {} },
          "required": ["runtime"]
        }
      }
    }
  ],
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command", "args", "transport"],
      "properties": {
        "type": { "const": "local_process" },
        "command": { "type": "string", "minLength": 1, "maxLength": 512 },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 1024 }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "healthPath"],
          "properties": {
            "type": { "const": "http" },
            "healthPath": { "$ref": "#/$defs/httpPath" }
          }
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "pageId", "group"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "pageId": { "$ref": "#/$defs/contributionId" },
        "group": { "enum": ["creation", "workspace", "tools"] },
        "icon": { "enum": ["audio-lines", "video", "image", "wand-sparkles", "puzzle", "box", "cpu"] },
        "order": { "type": "integer", "minimum": -10000, "maximum": 10000 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "source": { "const": "runtime" },
        "path": { "$ref": "#/$defs/httpPath" }
      }
    },
    "modelResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "kind": { "enum": ["language", "tts", "speech_to_text", "speech_to_speech", "music", "lip_sync", "portrait_animation", "avatar_generation", "realtime_avatar", "upscaler"] },
        "required": { "type": "boolean" },
        "recommendedVramMb": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "license": { "type": "string", "maxLength": 256 },
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contributionId" }
        },
        "supportsStreaming": { "type": "boolean" },
        "commercialUse": { "enum": ["allowed", "restricted", "review_required"] }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "execution"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "execution": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["local", "cloud"] }
        },
        "optional": { "type": "boolean" }
      }
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "extensions", "mimeTypes", "mode"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "status": { "$ref": "#/$defs/contributionStatus" },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[a-z0-9][a-z0-9.-]{0,15}$" }
        },
        "mimeTypes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }
        },
        "mode": { "enum": ["readonly", "editable"] }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "status", "description", "capability", "risk"],
      "properties": {
        "name": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "status": { "$ref": "#/$defs/contributionStatus" },
        "description": { "type": "string", "maxLength": 2048 },
        "capability": { "$ref": "#/$defs/contributionId" },
        "risk": { "enum": ["R0", "R1", "R2", "R3"] }
      }
    },
    "workflowNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executorKey", "title", "status", "description"],
      "properties": {
        "executorKey": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "status": { "$ref": "#/$defs/contributionStatus" },
        "description": { "type": "string", "maxLength": 2048 }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "status": { "$ref": "#/$defs/contributionStatus" },
        "kind": { "enum": ["browser_provider", "native_app", "remote_service"] }
      }
    },
    "contributionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,255}$"
    },
    "contributionStatus": { "enum": ["available", "planned", "disabled"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 }
    ,
    "httpPath": { "type": "string", "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$", "maxLength": 1024 }
  }
}
