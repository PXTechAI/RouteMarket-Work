{
  "name": "@routemarket/work-desktop",
  "version": "0.2.0",
  "description": "Local-first desktop workspace for RouteMarket workflows, projects, agents and browser tasks.",
  "author": "PX Labs",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "build": {
    "appId": "ai.routemarket.work",
    "productName": "RouteMarket Work",
    "asar": true,
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.ROUTEMARKET_WORK_UPDATE_URL}",
        "channel": "latest",
        "useMultipleRangeRequest": false
      }
    ],
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "protocols": [
      {
        "name": "RouteMarket Work",
        "schemes": [
          "routemarket-work"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RouteMarket Work",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "scripts": {
    "prebuild": "corepack pnpm --filter @routemarket/work-protocol build && corepack pnpm --filter @routemarket/work-worker-core build",
    "build": "electron-vite build && node ../../scripts/verify-production-bundle.mjs out/main/index.js",
    "build:release": "electron-vite build --mode desktop-release && node ../../scripts/verify-production-bundle.mjs out/main/index.js",
    "build:test": "electron-vite build --mode desktop-test && node ../../scripts/verify-production-bundle.mjs out/main/index.js",
    "build:local": "electron-vite build --mode desktop-local",
    "predev": "corepack pnpm --filter @routemarket/work-protocol build && corepack pnpm --filter @routemarket/work-worker-core build",
    "predev:web": "corepack pnpm --filter @routemarket/work-protocol build && corepack pnpm --filter @routemarket/work-worker-core build",
    "pretest": "corepack pnpm --filter @routemarket/work-protocol build && corepack pnpm --filter @routemarket/work-worker-core build",
    "pretypecheck": "corepack pnpm --filter @routemarket/work-protocol build && corepack pnpm --filter @routemarket/work-worker-core build",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "dist:win": "node ../../scripts/check-release-environment.mjs --platform win32 && node ../../scripts/write-release-manifest.mjs --check-source --artifact-dir ../../release && corepack pnpm run build:release && electron-builder --win nsis --x64 --publish never && powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/verify-windows-signature.ps1 -ArtifactDirectory ../../release -Arch x64 && node ../../scripts/prepare-update-metadata.mjs --artifact-dir ../../release && node ../../scripts/write-release-manifest.mjs --artifact-dir ../../release --platform win32 --arch x64",
    "dist:win:dir": "corepack pnpm run build:local && electron-builder --win dir --x64",
    "dist:mac": "corepack pnpm run build && electron-builder --mac dmg",
    "lint": "tsc -p tsconfig.json --noEmit",
    "lint:styles": "node scripts/check-style-tokens.mjs && stylelint \"src/renderer/src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/renderer/src/**/*.scss\" --fix && node scripts/check-style-tokens.mjs",
    "format:styles": "prettier --write \"src/renderer/src/**/*.scss\"",
    "format:styles:check": "prettier --check \"src/renderer/src/**/*.scss\"",
    "test": "vitest run --passWithNoTests",
    "test:chat-smoke": "vitest run src/main/desktop-chat-smoke.integration.spec.ts",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:visual:update": "node scripts/visual-regression.mjs --update",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.0",
    "@routemarket/work-protocol": "workspace:*",
    "@routemarket/work-worker-core": "workspace:*",
    "@xyflow/react": "^12.10.2",
    "electron-updater": "6.6.2",
    "lucide-react": "^0.468.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^4.0.0",
    "prettier": "3.9.6",
    "sass": "^1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^4.1.5"
  }
}
